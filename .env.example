# ==============================================================================
# OmniDoc-Vision Environment Configuration Template
# ==============================================================================

# Application & Server
APP_NAME=omnidoc-vision
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
# The API and vLLM must not share a port.
PORT=8001

# Host Port Mappings (Docker Compose - Prevents collisions with omniops & omnidoc-rag)
API_HOST_PORT=8003
UI_HOST_PORT=8004
QDRANT_HOST_PORT=6335
QDRANT_GRPC_HOST_PORT=6336
REDIS_HOST_PORT=6380
LANGFUSE_HOST_PORT=3002

# HuggingFace Model Cache Mount (Docker Compose)
# Set to your host cache (e.g. ~/.cache/huggingface on Linux/macOS or C:/Users/<username>/.cache/huggingface on Windows)
# If left as huggingface_cache, a Docker named volume is used automatically.
HF_CACHE_DIR=huggingface_cache

# vLLM / OpenAI-Compatible Vision-Language Model
VLM_BASE_URL=http://localhost:8000/v1
VLM_API_KEY=EMPTY
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
VLM_TEMPERATURE=0.1
VLM_MAX_TOKENS=1024

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# Vector Store (Qdrant) & Sparse Search (BM25)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnidoc_vision_chunks
BM25_INDEX_DIR=data/bm25_index

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Ingestion, Assets & Security Bounds
RAW_PDFS_DIR=data/raw_pdfs
CROPS_DIR=data/crops
MAX_IMAGE_DIM=1280
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=100
MAX_IMAGES_PER_QUERY=2
DOCLING_DEVICE=cpu
